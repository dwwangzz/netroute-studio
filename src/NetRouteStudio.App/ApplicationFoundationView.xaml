<UserControl x:Class="NetRouteStudio.App.ApplicationFoundationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="8" Padding="28">
        <StackPanel>
            <TextBlock Text="应用基础" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="应用运行环境与基础设施状态" Foreground="#6B7280" Margin="0,5,0,24" />
            <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="NetRoute Studio" FontSize="18" FontWeight="SemiBold" />
                        <Border HorizontalAlignment="Right" Background="#DBEAFE" CornerRadius="10" Padding="10,3">
                            <TextBlock Text="{Binding ApplicationVersionDisplay}" Foreground="#1D4ED8" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text=".NET 8 · WPF · MVVM · 依赖注入 · Serilog" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding PrivilegeStatus}" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock Text="已启用：全局异常处理、结构化 PowerShell 执行、滚动日志和管理员权限检测"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
