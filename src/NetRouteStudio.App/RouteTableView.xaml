<UserControl x:Class="NetRouteStudio.App.RouteTableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" CornerRadius="8" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="路由查看" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="分页查看 Windows IPv4 与 IPv6 路由表" Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel><Button Command="{Binding RefreshRoutesCommand}" Content="刷新路由" HorizontalAlignment="Right" Padding="16,8"/></Grid><Grid Grid.Row="1" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="9,6" ToolTip="搜索目标、下一跳、接口或协议"/><ComboBox Grid.Column="1" ItemsSource="{Binding AddressFamilyOptions}" SelectedItem="{Binding AddressFamilyFilter}" Margin="10,0,0,0" Padding="8,5"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding VisibleRoutes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="协议族" Binding="{Binding AddressFamilyDisplay}" Width="75"/><DataGridTextColumn Header="目标" Binding="{Binding DestinationPrefix}" Width="180"/><DataGridTextColumn Header="下一跳" Binding="{Binding NextHop}" Width="160"/><DataGridTextColumn Header="接口" Binding="{Binding InterfaceAlias}" Width="170"/><DataGridTextColumn Header="索引" Binding="{Binding InterfaceIndex}" Width="55"/><DataGridTextColumn Header="路由 Metric" Binding="{Binding RouteMetric}" Width="85"/><DataGridTextColumn Header="接口 Metric" Binding="{Binding InterfaceMetric}" Width="85"/><DataGridTextColumn Header="有效 Metric" Binding="{Binding EffectiveMetric}" Width="85"/><DataGridTextColumn Header="状态" Binding="{Binding LifetimeDisplay}" Width="120"/><DataGridTextColumn Header="来源" Binding="{Binding OperabilityDisplay}" Width="100"/></DataGrid.Columns></DataGrid><Grid Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#4B5563"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding PreviousPageCommand}" Content="上一页" Padding="14,6"/><TextBlock Text="{Binding PageNumber}" Margin="12,0,4,0" VerticalAlignment="Center"/><TextBlock Text="/" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalPages}" Margin="4,0,12,0" VerticalAlignment="Center"/><Button Command="{Binding NextPageCommand}" Content="下一页" Padding="14,6"/></StackPanel></Grid></Grid></Border>
</UserControl>
