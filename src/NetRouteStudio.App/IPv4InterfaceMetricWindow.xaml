<Window x:Class="NetRouteStudio.App.IPv4InterfaceMetricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetRouteStudio.App.Controls"
        Title="网卡跃点管理" Width="1100" Height="650" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="网卡跃点管理" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="分别管理 IPv4 和 IPv6 接口 Metric，两种地址族的设置互不影响。" Foreground="#6B7280" Margin="0,5,0,0" />
            </StackPanel>
            <Button Command="{Binding RefreshCommand}" Content="刷新" HorizontalAlignment="Right" Width="78" Height="34"
                    Background="#2563EB" Foreground="White" BorderThickness="0" />
        </Grid>
        <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14">
            <TextBlock Text="接口 Metric 会影响路由的有效 Metric 和出口选择，修改前请确认当前网络连接。" Foreground="#9A3412" />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="网卡" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="索引" Binding="{Binding InterfaceIndex}" Width="55" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="75" />
                    <DataGridTextColumn Header="IPv4 地址" Binding="{Binding IPv4Display}" Width="190" />
                    <DataGridTextColumn Header="IPv4 Metric" Binding="{Binding IPv4MetricDisplay}" Width="135" />
                    <DataGridTextColumn Header="IPv6 地址" Binding="{Binding IPv6Display}" Width="220" />
                    <DataGridTextColumn Header="IPv6 Metric" Binding="{Binding IPv6MetricDisplay}" Width="135" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TabControl>
                        <TabItem Header="IPv4 跃点">
                            <StackPanel Margin="10">
                                <TextBlock Text="IPv4 跃点设置" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="所选网卡" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBlock Text="{Binding SelectedAdapter.SelectionDisplay}" TextWrapping="Wrap" Foreground="#374151" />
                                <CheckBox IsChecked="{Binding AutomaticMetric}" Content="启用 Windows IPv4 自动跃点" Margin="0,18,0,0" />
                                <TextBlock Text="手动 IPv4 接口 Metric" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBox Text="{Binding ManualMetric, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManualMetricEnabled}"
                                         Padding="8,6" ToolTip="允许范围：1 到 9999" />
                                <TextBlock Text="允许范围：1 到 9999。启用自动跃点后，该值不会提交。" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button Command="{Binding UpdateCommand}" Content="预览 IPv4 命令并修改" Padding="16,8" Margin="0,20,0,0"
                                        Background="#2563EB" Foreground="White" BorderThickness="0" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="IPv6 跃点">
                            <StackPanel Margin="10">
                                <TextBlock Text="IPv6 跃点设置" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="所选网卡" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBlock Text="{Binding SelectedAdapter.SelectionDisplay}" TextWrapping="Wrap" Foreground="#374151" />
                                <TextBlock Text="{Binding SelectedAdapter.IPv6Display, StringFormat=IPv6 地址：{0}}" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,5,0,0" />
                                <CheckBox IsChecked="{Binding Ipv6AutomaticMetric}" Content="启用 Windows IPv6 自动跃点" Margin="0,16,0,0" />
                                <TextBlock Text="手动 IPv6 接口 Metric" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <TextBox Text="{Binding Ipv6ManualMetric, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIPv6ManualMetricEnabled}"
                                         Padding="8,6" ToolTip="允许范围：1 到 9999" />
                                <TextBlock Text="允许范围：1 到 9999。无 IPv6 地址的网卡仍可查看和修改接口配置。" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button Command="{Binding UpdateIPv6Command}" Content="预览 IPv6 命令并修改" Padding="16,8" Margin="0,20,0,0"
                                        Background="#7C3AED" Foreground="White" BorderThickness="0" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="6,10,6,0" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#4B5563" VerticalAlignment="Center" />
            <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" Padding="20,8" />
        </Grid>
        <controls:LoadingIndicator IsActive="{Binding IsLoading}" Message="正在加载网卡跃点信息…"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0" Panel.ZIndex="20" />
    </Grid>
</Window>
