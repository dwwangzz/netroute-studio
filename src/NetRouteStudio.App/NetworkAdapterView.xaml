<UserControl x:Class="NetRouteStudio.App.NetworkAdapterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" CornerRadius="8" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="网卡管理" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="查看物理和虚拟网卡的地址、DNS、网关及接口状态" Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel><Button Command="{Binding RefreshAdaptersCommand}" Content="刷新网卡" HorizontalAlignment="Right" Padding="16,8"/></Grid><TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,10"/><DataGrid Grid.Row="2" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="类型" Binding="{Binding KindDisplay}" Width="90"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/><DataGridTextColumn Header="索引" Binding="{Binding InterfaceIndex}" Width="60"/><DataGridTextColumn Header="IPv4 地址" Binding="{Binding IPv4Display}" Width="200"/><DataGridTextColumn Header="IPv6 地址" Binding="{Binding IPv6Display}" Width="260"/><DataGridTextColumn Header="DNS" Binding="{Binding DnsDisplay}" Width="180"/><DataGridTextColumn Header="默认网关" Binding="{Binding GatewayDisplay}" Width="160"/><DataGridTextColumn Header="IPv4 Metric" Binding="{Binding IPv4MetricDisplay}" Width="110"/><DataGridTextColumn Header="IPv6 Metric" Binding="{Binding IPv6MetricDisplay}" Width="110"/></DataGrid.Columns></DataGrid></Grid></Border>
</UserControl>
