<UserControl x:Class="NetRouteStudio.App.RouteMatchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NetRouteStudio.App.Controls">
 <Grid>
 <Border Background="White" CornerRadius="8" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="路由匹配" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="输入 IP 地址或域名，查看全部候选路由和最终命中结果" Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel><Grid Grid.Row="1" Margin="0,16,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/><Button Grid.Column="1" Command="{Binding MatchCommand}" Content="开始匹配" Padding="18,8" Margin="10,0,0,0" Background="#2563EB" Foreground="White" BorderThickness="0"/></Grid><StackPanel Grid.Row="2"><TextBlock Text="{Binding DecisionReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding VerificationMessage}" Foreground="#047857" Margin="0,4"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding ResolvedMatches}" SelectedItem="{Binding SelectedMatch}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="解析地址" Binding="{Binding TargetAddress}" Width="*"/><DataGridTextColumn Header="命中目标" Binding="{Binding MatchedRoute.DestinationPrefix}" Width="160"/><DataGridTextColumn Header="下一跳" Binding="{Binding MatchedRoute.NextHop}" Width="140"/></DataGrid.Columns></DataGrid><DataGrid Grid.Column="2" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="候选目标" Binding="{Binding Route.DestinationPrefix}" Width="150"/><DataGridTextColumn Header="接口" Binding="{Binding Route.InterfaceAlias}" Width="120"/><DataGridTextColumn Header="前缀" Binding="{Binding PrefixLength}" Width="55"/><DataGridTextColumn Header="判断理由" Binding="{Binding MatchReason}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Grid></Border>
  <controls:LoadingIndicator IsActive="{Binding IsLoading}" Message="正在匹配路由…" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,82,0,0" Panel.ZIndex="20"/>
 </Grid>
</UserControl>
