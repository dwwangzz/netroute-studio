<Window x:Class="NetRouteStudio.App.RouteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认路由操作" Width="820" Height="680" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F3F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding OperationName}" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="请核对全部字段和即将执行的命令。确认后将立即修改 Windows 路由表。"
                       Margin="0,6,0,0" Foreground="#6B7280" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="8" BorderBrush="#DCE3EC" BorderThickness="1" Padding="12">
                <DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="操作前" Binding="{Binding BeforeValue}" Width="*" MinWidth="210" />
                        <DataGridTextColumn Header="操作后" Binding="{Binding AfterValue}" Width="*" MinWidth="210" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="即将执行的路由策略命令" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton" Content="复制命令" DockPanel.Dock="Right" Click="OnCopyCommand"
                                Padding="12,5" Background="#374151" Foreground="White" BorderThickness="0" />
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding Command}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                             Background="#111827" Foreground="#D1FAE5" BorderThickness="0"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Padding="20,8" Margin="0,0,10,0" />
            <Button Content="确认执行" IsDefault="True" Click="OnConfirm" Padding="20,8"
                    Background="#DC2626" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
