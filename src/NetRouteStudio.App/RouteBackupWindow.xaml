<Window x:Class="NetRouteStudio.App.RouteBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetRouteStudio.App.Controls"
        Title="备份恢复 - IPv4 路由备份" Width="1120" Height="720" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="IPv4 路由备份" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="创建或校验 JSON 备份，并比较当前系统；额外路由仅在明确勾选后删除。" Foreground="#6B7280" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding CreateBackupCommand}" Content="创建备份" Padding="16,8" Margin="0,0,10,0"
                        Background="#2563EB" Foreground="White" BorderThickness="0" />
                <Button Command="{Binding OpenBackupCommand}" Content="打开并校验" Padding="16,8" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="文件：" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                <TextBlock Grid.Row="1" Text="格式版本：" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormatVersion}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="创建时间：" FontWeight="SemiBold" Margin="20,0,0,0" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CreatedAt}" />
                <TextBlock Grid.Row="2" Text="计算机：" FontWeight="SemiBold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ComputerName}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="应用版本：" FontWeight="SemiBold" Margin="20,0,0,0" /><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AppVersion}" />
                <TextBlock Grid.Row="3" Text="Windows：" FontWeight="SemiBold" /><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding WindowsVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowsVersion}" />
                <TextBlock Grid.Row="4" Text="SHA-256：" FontWeight="SemiBold" /><TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Sha256}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sha256}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="9"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HostWarning}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HostWarning}" Foreground="#B91C1C" TextWrapping="Wrap" />
            </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="IPv4 路由">
                <DataGrid ItemsSource="{Binding Routes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="目标" Binding="{Binding DestinationPrefix}" Width="180" />
                        <DataGridTextColumn Header="下一跳" Binding="{Binding NextHop}" Width="150" />
                        <DataGridTextColumn Header="接口" Binding="{Binding InterfaceAlias}" Width="170" />
                        <DataGridTextColumn Header="索引" Binding="{Binding InterfaceIndex}" Width="55" />
                        <DataGridTextColumn Header="路由 Metric" Binding="{Binding RouteMetric}" Width="90" />
                        <DataGridTextColumn Header="接口 Metric" Binding="{Binding InterfaceMetric}" Width="90" />
                        <DataGridTextColumn Header="有效 Metric" Binding="{Binding EffectiveMetric}" Width="90" />
                        <DataGridTextColumn Header="状态" Binding="{Binding LifetimeDisplay}" Width="120" />
                        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="相关网卡">
                <DataGrid ItemsSource="{Binding Adapters}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="网卡" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="描述" Binding="{Binding InterfaceDescription}" Width="240" />
                        <DataGridTextColumn Header="索引" Binding="{Binding InterfaceIndex}" Width="55" />
                        <DataGridTextColumn Header="IPv4 地址" Binding="{Binding IPv4Display}" Width="190" />
                        <DataGridTextColumn Header="网关" Binding="{Binding GatewayDisplay}" Width="170" />
                        <DataGridTextColumn Header="DNS" Binding="{Binding DnsDisplay}" Width="190" />
                        <DataGridTextColumn Header="IPv4 Metric" Binding="{Binding IPv4MetricDisplay}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="差异与选择性恢复">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="缺失/配置不同项用于恢复；仅当前存在项默认不选，手动勾选后删除。"
                                   Foreground="#92400E" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Command="{Binding CompareCurrentCommand}" Content="比较当前系统" Padding="14,7" Margin="0,0,8,0" />
                            <Button Command="{Binding RestoreSelectedCommand}" Content="预览命令并执行选中差异" Padding="14,7"
                                    Background="#DC2626" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RestoreItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="执行" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanRestore}" HorizontalAlignment="Center"
                                                  Click="OnRestoreSelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="差异" Binding="{Binding DifferenceDisplay}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskDisplay}" IsReadOnly="True" Width="145" />
                            <DataGridTextColumn Header="目标" Binding="{Binding DestinationPrefix}" IsReadOnly="True" Width="180" />
                            <DataGridTextColumn Header="下一跳" Binding="{Binding NextHop}" IsReadOnly="True" Width="150" />
                            <DataGridTemplateColumn Header="恢复到当前接口" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.CurrentAdapters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="SelectionDisplay"
                                                  IsEnabled="{Binding CanSelectAdapter}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="备份 Metric" Binding="{Binding BackupMetric}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="当前 Metric" Binding="{Binding CurrentMetric}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="备份状态" Binding="{Binding BackupLifetime}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="当前状态" Binding="{Binding CurrentLifetime}" IsReadOnly="True" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#4B5563" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,4,100,0" />
            </StackPanel>
            <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" Padding="20,8" />
        </Grid>
        <controls:LoadingIndicator IsActive="{Binding IsLoading}" Message="正在处理备份与路由信息…"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0" Panel.ZIndex="20" />
    </Grid>
</Window>
