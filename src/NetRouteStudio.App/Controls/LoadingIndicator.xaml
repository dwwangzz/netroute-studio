<UserControl x:Class="NetRouteStudio.App.Controls.LoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border Background="#F2FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1"
            CornerRadius="6" Padding="10,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#1D4ED8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ProgressBar Grid.Column="1" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Foreground="{StaticResource PrimaryBrush}" Background="#DBEAFE" />
        </Grid>
    </Border>
</UserControl>
