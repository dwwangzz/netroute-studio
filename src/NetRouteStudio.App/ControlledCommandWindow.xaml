<Window x:Class="NetRouteStudio.App.ControlledCommandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="受控网络命令" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F3F6FA">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="受控网络命令" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="默认启用安全白名单；无论开关状态，都不会通过 CMD 或 PowerShell 解释。" Foreground="#6B7280" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel HorizontalAlignment="Right"><CheckBox Content="启用命令白名单" IsChecked="{Binding IsWhitelistEnabled}" Unchecked="OnWhitelistUnchecked" Checked="OnWhitelistChecked" FontWeight="SemiBold"/><TextBlock Text="白名单已关闭：仅保留基础安全拦截" Foreground="#DC2626" FontWeight="SemiBold" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsWhitelistEnabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="命令示例" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Examples}" SelectedItem="{Binding SelectedExample}" DisplayMemberPath="DisplayText" Padding="8,5"/><Button Grid.Column="2" Command="{Binding FillExampleCommand}" Content="填入命令" Padding="16,7" Margin="8,0,0,0"/></Grid>
  <Grid Grid.Row="2" Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" FontFamily="Consolas"/><Button Grid.Column="1" Command="{Binding ExecuteCommand}" Content="执行" Padding="20,8" Margin="10,0,0,0" Background="#2563EB" Foreground="White" BorderThickness="0"/><Button Grid.Column="2" Command="{Binding CancelCommand}" Content="取消" Padding="20,8" Margin="8,0,0,0"/></Grid>
  <StackPanel Grid.Row="3"><TextBlock Text="{Binding StatusMessage}" Foreground="#4B5563"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,4,0,8" TextWrapping="Wrap"/></StackPanel>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,6"><TextBlock Text="执行记录" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="清空记录" Click="OnClearHistory" IsEnabled="{Binding HasHistory}" HorizontalAlignment="Right" Padding="12,5"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding StartedAt, StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="85"/></DataGrid.Columns></DataGrid></Grid><TextBox x:Name="OutputTextBox" Grid.Column="2" Text="{Binding Output}" TextChanged="OnOutputTextChanged" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="复制命令" Click="OnCopyCommand" Padding="16,8"/><Button Content="复制输出" Click="OnCopy" Padding="16,8" Margin="8,0,0,0"/><Button Content="关闭" IsCancel="True" Padding="20,8" Margin="8,0,0,0"/></StackPanel>
 </Grid>
</Window>
