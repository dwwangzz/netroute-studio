<Window x:Class="NetRouteStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetRoute Studio" Width="1180" Height="700" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111827" Padding="28,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NETROUTE STUDIO" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Windows 网络策略管理" Foreground="#9CA3AF" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="功能模块" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />
                    <TextBlock Text="✓  应用基础" Foreground="#6B7280" Margin="0,8" />
                    <TextBlock Text="✓  网卡管理" Foreground="#6B7280" Margin="0,8" />
                    <TextBlock Text="✓  路由管理" Foreground="#6B7280" Margin="0,8" />
                    <TextBlock Text="●  路由匹配" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,8" />
                    <TextBlock Text="○  备份恢复" Foreground="#9CA3AF" Margin="0,8" />
                    <TextBlock Text="○  网络测试" Foreground="#9CA3AF" Margin="0,8" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="路由匹配" FontSize="26" FontWeight="SemiBold" Foreground="#111827" />
                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="12" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"
                                 ToolTip="输入 IPv4 或 IPv6 地址，例如 8.8.8.8" />
                        <Button Grid.Column="2" Command="{Binding MatchCommand}" Content="开始匹配"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" />
                        <ProgressBar Grid.Column="3" Width="120" Height="3" HorizontalAlignment="Right" IsIndeterminate="True">
                            <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                    <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="程序计算结果" FontWeight="SemiBold" Foreground="#1E3A8A" />
                                <TextBlock Text="{Binding MatchedRoute.DestinationPrefix, TargetNullValue=尚未匹配}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,3" />
                                <TextBlock><Run Text="下一跳：" /><Run Text="{Binding MatchedRoute.NextHop}" /><Run Text="    接口：" /><Run Text="{Binding MatchedRoute.InterfaceAlias}" /></TextBlock>
                                <TextBlock Text="{Binding DecisionReason}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Windows 原生验证" FontWeight="SemiBold" Foreground="#166534" />
                                <TextBlock Text="{Binding NativeRoute.DestinationPrefix, TargetNullValue=尚未查询}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,3" />
                                <TextBlock><Run Text="下一跳：" /><Run Text="{Binding NativeRoute.NextHop}" /><Run Text="    接口：" /><Run Text="{Binding NativeRoute.InterfaceAlias}" /></TextBlock>
                                <TextBlock Text="{Binding VerificationMessage}" TextWrapping="Wrap" Foreground="#166534" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="全部候选路由（已按优先级排序）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="目标前缀" Binding="{Binding Route.DestinationPrefix}" Width="1.3*" />
                                <DataGridTextColumn Header="下一跳" Binding="{Binding Route.NextHop}" Width="1.2*" />
                                <DataGridTextColumn Header="接口" Binding="{Binding Route.InterfaceAlias}" Width="*" />
                                <DataGridTextColumn Header="前缀长度" Binding="{Binding PrefixLength}" Width="72" />
                                <DataGridTextColumn Header="路由跃点" Binding="{Binding Route.RouteMetric}" Width="72" />
                                <DataGridTextColumn Header="接口跃点" Binding="{Binding Route.InterfaceMetric}" Width="72" />
                                <DataGridTextColumn Header="综合" Binding="{Binding Route.EffectiveMetric}" Width="55" />
                                <DataGridTextColumn Header="判断依据" Binding="{Binding MatchReason}" Width="1.7*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#E5E7EB" Padding="28,0"><TextBlock Text="路由匹配模块" VerticalAlignment="Center" Foreground="#4B5563" /></Border>
    </Grid>
</Window>
