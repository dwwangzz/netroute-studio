<Window x:Class="NetRouteStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetRoute Studio" Width="1180" Height="700" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111827" Padding="28,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NETROUTE STUDIO" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Windows 网络策略管理" Foreground="#9CA3AF" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="功能模块" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />
                    <TextBlock Text="✓  应用基础" Foreground="#6B7280" Margin="0,7" />
                    <TextBlock Text="✓  网卡管理" Foreground="#6B7280" Margin="0,7" />
                    <TextBlock Text="✓  路由查看" Foreground="#6B7280" Margin="0,7" />
                    <TextBlock Text="✓  路由匹配" Foreground="#6B7280" Margin="0,7" />
                    <TextBlock Text="●  IPv4 路由管理" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,7" />
                    <Button Content="网卡跃点管理" Click="OnOpenIPv4InterfaceMetric" HorizontalContentAlignment="Left"
                            Margin="0,5" Padding="8,7" Background="#ECFDF5" Foreground="#047857" BorderBrush="#A7F3D0"
                            ToolTip="查看并设置 IPv4、IPv6 接口自动或手动 Metric" />
                    <Button Content="备份恢复" Click="OnOpenRouteBackup" HorizontalContentAlignment="Left"
                            Margin="0,5" Padding="8,7" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE"
                            ToolTip="创建、校验和预览 IPv4 路由备份" />
                    <Button Content="IP 绑定重置" Click="OnOpenIPv6Reset" HorizontalContentAlignment="Left"
                            Margin="0,5" Padding="8,7" Background="#FEF2F2" Foreground="#B91C1C" BorderBrush="#FECACA"
                            ToolTip="安全重置单张网卡的 IPv4（ms_tcpip）或 IPv6（ms_tcpip6）绑定" />
                    <Button Content="网络测试" Click="OnOpenNetworkTest" HorizontalContentAlignment="Left"
                            Margin="0,5" Padding="8,7" Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0"
                            ToolTip="执行 DNS、Ping、路由命中和 Tracert 只读诊断" />
                    <Button Content="受控网络命令" Click="OnOpenControlledCommand" HorizontalContentAlignment="Left"
                            Margin="0,5" Padding="8,7" Background="#FFF7ED" Foreground="#C2410C" BorderBrush="#FED7AA"
                            ToolTip="执行经过白名单和参数校验的 Windows 网络命令" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="24">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IPv4 路由管理" FontSize="26" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="所有操作完成后都会重新读取 Windows 实际路由表进行验证" Foreground="#6B7280" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="0" Width="260" Height="34" HorizontalAlignment="Right"
                                 VerticalContentAlignment="Center" Margin="0,0,18,0" Padding="9,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索目标、下一跳、接口、索引、状态或来源" />
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="刷新" Width="78" Height="34"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" />
                    </Grid>
                    <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,14">
                        <TextBlock Text="修改或删除系统路由可能立即中断网络连接，请在确认目标、接口和 Metric 后操作。" Foreground="#9A3412" />
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="全部 IPv4 路由" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="目标" Binding="{Binding DestinationPrefix}" Width="170" MinWidth="120" />
                                    <DataGridTextColumn Header="下一跳" Binding="{Binding NextHop}" Width="150" MinWidth="110" />
                                    <DataGridTextColumn Header="接口" Binding="{Binding InterfaceAlias}" Width="170" MinWidth="100" />
                                    <DataGridTextColumn Header="索引" Binding="{Binding InterfaceIndex}" Width="48" />
                                    <DataGridTextColumn Header="路由 Metric" Binding="{Binding RouteMetric}" Width="76" />
                                    <DataGridTextColumn Header="接口 Metric" Binding="{Binding InterfaceMetric}" Width="76" />
                                    <DataGridTextColumn Header="有效 Metric" Binding="{Binding EffectiveMetric}" Width="76" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding LifetimeDisplay}" Width="110" />
                                    <DataGridTextColumn Header="来源" Binding="{Binding OperabilityDisplay}" Width="88" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="路由参数" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="目标 CIDR" FontWeight="SemiBold" Margin="0,15,0,4" />
                                    <TextBox Text="{Binding DestinationPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="例如 10.20.0.0/16" />
                                    <TextBlock Text="下一跳" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <ComboBox ItemsSource="{Binding NextHopOptions}" Text="{Binding NextHop, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" IsTextSearchEnabled="False" Padding="8,6"
                                              ToolTip="选择已有网关、手动输入，或使用 0.0.0.0 表示在链路上" />
                                    <TextBlock Text="网络接口" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                                              DisplayMemberPath="SelectionDisplay" Padding="8,6"
                                              ToolTip="只能选择 Windows 当前存在的网络接口" />
                                    <TextBlock Text="路由 Metric" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBox Text="{Binding RouteMetric, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                    <CheckBox IsChecked="{Binding IsPersistent}" Content="永久保存（默认仅临时生效）" Margin="0,14,0,0" />
                                    <WrapPanel Margin="0,18,0,0">
                                        <Button Command="{Binding CreateCommand}" Content="新增" Padding="16,7" Margin="0,0,8,8" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" />
                                        <Button Command="{Binding UpdateCommand}" Content="修改" Padding="16,7" Margin="0,0,8,8" />
                                        <Button Command="{Binding DeleteCommand}" Content="删除" Padding="16,7" Margin="0,0,8,8" Foreground="#B91C1C" />
                                        <Button Command="{Binding ClearFormCommand}" Content="清空" Padding="16,7" Margin="0,0,0,8" />
                                        <Button Command="{Binding BatchManageCommand}" Content="批量管理" Padding="16,7" Margin="8,0,0,8"
                                                Background="#0F766E" Foreground="White" BorderThickness="0" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#E5E7EB" Padding="28,0"><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#4B5563" /></Border>
    </Grid>
</Window>
